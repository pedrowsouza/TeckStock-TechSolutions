3. Database — Banco de dados
Criado para realizar o backup do Banco de dados

#################################################################

# TechSolutions — Backup do Banco de Dados

1. Na máquina atual 

powershell
docker exec mysql-techstock mysqldump -uroot -proot techsolutions > .\backups\techsolutions_backup.sql

2. Na nova máquina (dentro da pasta database)

powershell
docker run --name mysql-techstock -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=techsolutions -p 3306:3306 -d mysql:8.0

powershell
Get-Content .\backups\techsolutions_backup.sql | docker exec -i mysql-techstock mysql -uroot -proot techsolutions

powershell
Set-Content -Path ..\backend\.env -Value "DB_HOST=127.0.0.1`nDB_PORT=3306`nDB_USER=root`nDB_PASSWORD=root`nDB_NAME=techsolutions"

3. Iniciar Backend (Terminal 1)

powershell
cd ..\backend
npm install
node src/server.js

4. Iniciar Frontend (Terminal 2)

powershell
cd ..\frontend
npm install
npm run dev
